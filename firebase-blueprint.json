{
  "entities": {
    "Listing": {
      "title": "Listing",
      "description": "Bidhaa au mazao ya kilimo yanayouzwa na wakulima.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "quantityAvailable": { "type": "number" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "farmerPhone": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageUrls": { "type": "array" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"], "description": "Hali ya uhakiki wa bidhaa sokoni." }
      },
      "required": ["title", "category", "price", "unit", "quantityAvailable", "location", "farmerName", "farmerPhone"]
    },
    "Message": {
      "title": "Message",
      "description": "Ujumbe kati ya mkulima na mnunuzi.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" },
        "listingId": { "type": "string" }
      },
      "required": ["senderId", "senderName", "receiverId", "text", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Wasifu wa mtumiaji wa jukwaa la Wakulima.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "phone", "email"]
    }
  },
  "firestore": {
    "listings/{listingId}": {
      "schema": "Listing",
      "description": "Orodha ya mazao na bidhaa za kilimo."
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Ujumbe wa soga kati ya wakulima na wanunuzi."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Maelezo ya wasifu wa mtumiaji (Mkulima au Mnunuzi)."
    }
  }
}
